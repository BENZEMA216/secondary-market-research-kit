{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scenario-router:schema:feed-manifest:1",
  "title": "Article-feed completeness manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "provider",
    "captured_at_utc",
    "pagination_complete",
    "raw_manifest_sha256",
    "coverage"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "feed_manifest"},
    "provider": {"type": "string", "minLength": 1},
    "captured_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "pagination_complete": {"const": true},
    "raw_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["security_id", "ticker_at_event", "start_at_utc", "end_at_utc", "status"],
        "properties": {
          "security_id": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "value"],
            "properties": {
              "scheme": {"enum": ["FIGI", "QC_SID"]},
              "value": {"type": "string", "minLength": 1}
            }
          },
          "ticker_at_event": {"type": "string", "minLength": 1},
          "start_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
          "end_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
          "status": {"enum": ["complete", "missing"]}
        }
      }
    }
  }
}
